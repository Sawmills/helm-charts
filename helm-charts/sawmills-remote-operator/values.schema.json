{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "autoscaler": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "dryRun": { "type": ["boolean", "null"] },
        "metricsEndpoint": { "type": ["string", "null"], "minLength": 1 },
        "targetHPAName": { "type": ["string", "null"], "minLength": 1 },
        "leaseName": { "type": ["string", "null"], "minLength": 1 },
        "labelSelectors": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "string" }
        },
        "memoryLimitBytes": { "type": ["integer", "null"], "minimum": 1 },
        "globalMinReplicas": { "type": ["integer", "null"], "minimum": 1 },
        "globalMaxReplicas": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "proxy": {
      "type": "object",
      "properties": {
        "http": { "type": "string" },
        "https": { "type": "string" },
        "noProxy": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
